
---
import BaseLayout from "../layouts/BaseLayout.astro";
import PortfolioSections from "../components/PortfolioSections.astro";
import ProjectCard from "../components/ProjectCard.astro";

import projectsData from "../data/projects.en.json";
import skillsData from "../data/skills.en.json";
import experienceData from "../data/experience.en.json";

import type { Project } from "../types/project";
import type { SkillGroup } from "../types/skill";
import type { Experience } from "../types/experience";

const projects: Project[] = projectsData;
const skills: SkillGroup[] = skillsData;
const experiences: Experience[] = experienceData;
---

<BaseLayout
  lang="en"
  title="Your Name | Full Stack Developer"
  description="Explore my projects, skills and professional experience."
>
  <PortfolioSections lang="en" skills={skills} experiences={experiences}>
    <section
      slot="projects"
      id="projects"
      class="mx-auto max-w-6xl scroll-mt-8 px-5 py-16"
    >
      <p class="text-sm font-semibold uppercase tracking-widest text-blue-600">
        Portfolio
      </p>

      <h2 class="mt-3 text-3xl font-bold">Featured projects</h2>

      <p class="mt-4 text-slate-600 dark:text-slate-400">
        A selection of projects I have built or am currently developing.
      </p>

      <div class="mt-8 grid items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <ProjectCard project={project} lang="en" />
        ))}
      </div>
    </section>
  </PortfolioSections>
</BaseLayout>
