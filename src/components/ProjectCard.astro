---
import type { Project } from "../types/project";

interface Props {
  project: Project;
  lang: "en" | "es";
}

const { project, lang } = Astro.props;
const isSpanish = lang === "es";
---

<article
  class="flex h-full flex-col overflow-hidden rounded-2xl
         border border-slate-200 bg-white
         transition hover:-translate-y-1 hover:shadow-lg
         dark:border-slate-800 dark:bg-slate-900"
>
  {
    project.url ? (
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Ver proyecto: ${project.name}`}
        class="group relative block aspect-video overflow-hidden rounded-xl bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 dark:bg-gray-800"
      >
        <img
          src={project.image.src}
          alt={project.image.alt}
          loading="lazy"
          class="h-full w-full object-cover transition duration-300 ease-in-out group-hover:scale-[1.03] group-hover:brightness-50 group-focus-visible:brightness-50 motion-reduce:transition-none"
        />

        <span class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100 motion-reduce:transition-none">
          <span class="rounded-lg bg-white/95 px-5 py-3 text-sm font-semibold text-gray-900 shadow-lg">
            {isSpanish ? "Ver proyecto" : "View project"} <span aria-hidden="true">↗</span>
          </span>
        </span>
      </a>
    ) : (
      <div class="aspect-video overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-800">
        <img
          src={project.image.src}
          alt={project.image.alt}
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-bold tracking-tight">
      {project.name}
    </h3>

    <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
      {project.description}
    </p>

    <div class="mt-5">
      <h4 class="text-sm font-semibold">
        {isSpanish ? "Objetivo" : "Objective"}
      </h4>
      <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-400">
        {project.objective}
      </p>
    </div>

    <div class="mt-5">
      <h4 class="text-sm font-semibold">
        {isSpanish ? "Mi participación" : "My contribution"}
      </h4>

      <ul
        class="mt-2 list-disc space-y-1 pl-5 text-sm
                 leading-6 text-slate-600 dark:text-slate-400"
      >
        {project.participation.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="mt-5">
      <h4 class="text-sm font-semibold">
        {isSpanish ? "Tecnologías" : "Technologies"}
      </h4>

      <div class="mt-2 flex flex-wrap gap-2">
        {
          [
            ...project.technologies.languages,
            ...project.technologies.frameworks,
            ...project.technologies.tools,
          ].map((technology) => (
            <span
              class="rounded-full bg-slate-100 px-3 py-1
                   text-xs font-medium text-slate-700
                   dark:bg-slate-800 dark:text-slate-300"
            >
              {technology}
            </span>
          ))
        }
      </div>
    </div>

    <details
      class="mt-5 border-t border-slate-200 pt-4
                    dark:border-slate-800"
    >
      <summary class="cursor-pointer text-sm font-semibold">
        {isSpanish ? "Detalles de implementación" : "Implementation details"}
      </summary>

      <ul
        class="mt-3 list-disc space-y-2 pl-5 text-sm
                 leading-6 text-slate-600 dark:text-slate-400"
      >
        {project.implementation.map((item) => <li>{item}</li>)}
      </ul>
    </details>

    <div class="mt-5">
      <h4 class="text-sm font-semibold">
        {isSpanish ? "Resultados" : "Results"}
      </h4>

      <ul
        class="mt-2 list-disc space-y-1 pl-5 text-sm
                 leading-6 text-slate-600 dark:text-slate-400"
      >
        {project.results.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    {
      project.url && (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-auto pt-6 font-semibold text-blue-600
             hover:text-blue-700 dark:text-blue-400"
        >
          {isSpanish ? "Ver proyecto" : "View project"}
        </a>
      )
    }
  </div>
</article>
